rules_version = '2';

// Perfiles:
//  - editor: los correos de la lista editor() (deben coincidir con `editores` en config.js).
//    Lee y escribe todo.
//  - consulta: cada correo agregado en la app (Datos → Usuarios y perfiles) queda en
//    _roles/<correo> con su perfil: 'consejo', 'revisor' o 'admin'. Solo lee, según su perfil:
//      consejo  → estados financieros, presupuesto, cartera, aclaraciones (sin impuestos ni archivos cargados).
//      admin    → lo del consejo + impuestos.
//      revisor  → lo de admin + verificación contable, auditoría del fondo de imprevistos (usa el libro auxiliar), verificación DIAN y conciliación bancaria.
// Pegue este texto en Firebase → Firestore Database → Reglas y pulse Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function correo() {
      return request.auth.token.email.lower();
    }
    function editor() {
      return autenticado() && correo() in [
        'aldair.melot@gmail.com',
        'aldairmelot@gmail.com'
      ];
    }
    function consulta() {
      return autenticado() && exists(/databases/$(database)/documents/_roles/$(correo()));
    }
    function perfil() {
      return get(/databases/$(database)/documents/_roles/$(correo())).data.rol;
    }
    function impuestos() {
      return ['retencion', 'retencion_pdf', 'iva', 'ica', 'prorrateo_cfg', 'prorrateo_mes'];
    }
    function revision() {
      return ['verif_idx', 'verif_raw', 'dianv', 'dianv_aux', 'dianv_cfg', 'dianv_idx', 'dianv_notas',
              'concb', 'concb_cfg', 'concb_expl', 'concb_idx', 'concb_notas', 'concb_raw', 'concb_wo'];
    }
    function archivos() {
      return ['_archivos', '_archivos_partes', 'archivos_cargados'];
    }
    function puedeLeer(col) {
      return editor() || (consulta() && (
        (!(col in impuestos()) && !(col in revision()) && !(col in archivos()))
        || (col in archivos() && perfil() in ['admin', 'revisor'])
        || (col in impuestos() && perfil() in ['admin', 'revisor'])
        || (col in revision() && perfil() == 'revisor')
      ));
    }

    // Perfiles: cada persona lee el suyo; solo el editor los asigna.
    match /_roles/{email} {
      allow read: if editor() || (autenticado() && correo() == email);
      allow write: if editor();
    }
    // Nombres de quienes entran (para mostrar quién cargó cada periodo).
    match /_usuarios/{uid} {
      allow read: if editor() || consulta();
      allow write: if editor() || (consulta() && request.auth.uid == uid);
    }
    // Firmas de los estados financieros: '<mes>_<rol>' (firma del mes) y 'persona_<correo>' (firma guardada).
    // Cada persona solo firma con su correo y en el papel que el editor le asignó (_roles/<correo>.firma).
    match /firmas/{id} {
      allow read: if editor() || consulta();
      allow create, update: if editor() || (consulta()
        && request.resource.data.email == correo()
        && (id == 'persona_' + correo()
            || (request.resource.data.rol == get(/databases/$(database)/documents/_roles/$(correo())).data.firma
                && id.matches('^[0-9]{4}-[0-9]{2}_' + request.resource.data.rol + '$'))));
      allow delete: if editor() || (consulta() && resource.data.email == correo());
    }
    // Todo lo demás: lectura según el perfil, escritura solo del editor.
    match /{col}/{doc=**} {
      allow read: if col != '_roles' && col != '_usuarios' && col != 'firmas' && puedeLeer(col);
      allow write: if col != '_roles' && col != '_usuarios' && col != 'firmas' && editor();
    }
  }
}
